{
  "name": "talkcad-desktop",
  "productName": "TalkCAD",
  "version": "0.1.0",
  "description": "LLM-powered conversational CAD application with OpenSCAD",
  "author": "TalkCAD Contributors",
  "private": true,
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron",
    "cli": "npx tsx scripts/cli-agent.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^9.92.0",
    "@react-three/fiber": "^8.15.0",
    "@talkcad/shared": "workspace:*",
    "clsx": "^2.1.0",
    "gpt-tokenizer": "^3.4.0",
    "monaco-editor": "^0.45.0",
    "pdf-extract-image": "^0.0.1",
    "pdf-parse": "1.1.1",
    "potrace": "^2.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "uuid": "^9.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/potrace": "^2.1.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "app.talkcad",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../resources/skills",
        "to": "assets/skills"
      }
    ]
  }
}
